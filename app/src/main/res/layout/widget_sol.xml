<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#FFF8FAFC">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SOL" android:textStyle="bold" android:textSize="15sp" android:textColor="#263445"/><TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY" android:textSize="10sp" android:textColor="#718096"/></LinearLayout>
<TextView android:id="@+id/widget_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Upcoming" android:textSize="12sp" android:textColor="#718096" android:paddingTop="5dp" android:paddingBottom="5dp"/>
<TextView android:id="@+id/widget_items" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="No reminders yet" android:textSize="12sp" android:textColor="#263445" android:gravity="top" android:maxLines="5"/>
<TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Add reminder" android:textSize="11sp" android:textColor="#456B91" android:gravity="end"/></LinearLayout>